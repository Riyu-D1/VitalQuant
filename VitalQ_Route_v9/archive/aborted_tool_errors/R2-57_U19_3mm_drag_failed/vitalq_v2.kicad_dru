(version 1)

(rule "JLC via hole to foreign copper 0.2mm"
  (condition "A.Type == 'Via' || B.Type == 'Via'")
  (constraint hole_clearance (min 0.2mm)))

(rule "JLC mechanically drilled hole separation 0.2mm"
  (constraint hole_to_hole (min 0.2mm)))

(rule "JLC through vias only"
  (constraint disallow blind_via buried_via micro_via))

(rule "JLC 0.09mm intra-footprint pad gap (SOT-23 pads are 0.100 mm apart; JLC min gap 0.09)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
  (constraint clearance (min 0.09mm)))
