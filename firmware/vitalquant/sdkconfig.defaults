# VitalQuant firmware v2 — fix_v22 (ESP32-S3-WROOM-1-N16R8)
# 16 MB QIO flash @ 3.3 V (IO45 strap must stay low — never burn VDD_SPI eFuse)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB OCTAL PSRAM — GPIO35/36/37 are reserved by it, firmware must never touch them
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Console: native USB-Serial/JTAG on GPIO19/20 (CP2102N data links are DNP)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Brown-out: ~2.7 V floor
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# App / watchdog / FreeRTOS
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_FREERTOS_HZ=1000

# Wi-Fi + BLE coexistence (BLE preferred for streaming bursts)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# FAT on internal 'storage' partition (LittleFS-free; no managed deps)
CONFIG_FATFS_VOLUME_COUNT=2

# mbedTLS for HTTPS cloud client
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
