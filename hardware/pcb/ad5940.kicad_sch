		(at 16.0 236.0 0)
		(effects (font (size 1.35 1.35)) (justify left bottom))
		(uuid "154c6bc1-db20-4bfb-ad50-423350b120f1")
	)
	(text "R13 is RCAL. C27 sits between RC0_0 and RC0_1. XTAL pins are open: the internal oscillator is used."
