	(text "C16 AVDD, C18 DVDD, C42 AVDD_REG, C19 IOVDD after R12, C20-C26 are the reference and bias caps."
		(exclude_from_sim no)
		(at 16.0 236.0 0)
		(effects (font (size 1.35 1.35)) (justify left bottom))
		(uuid "bdff4767-0904-4f92-8a2e-d8e764284a2f")
	)
	(text "R13 is RCAL. C27 sits between RC0_0 and RC0_1. XTAL pins are open: the internal oscillator is used."
