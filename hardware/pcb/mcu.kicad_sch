	(text "GPIO2 and GPIO12 are open so the straps stay low. GPIO15 (CS_AD5940) is pulled up."
		(exclude_from_sim no)
		(at 16.0 200.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "1a08864a-3929-4897-b703-339f52f52769")
	)
	(text "GPIO6-11 are the module flash bus and have no symbol pins. ADC1 is GPIO36 and GPIO39."
		(exclude_from_sim no)
		(at 16.0 208.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "79205d5b-f302-4b69-a7ff-2c4a19681900")
	)
	(text "EN has R5 10k and C64 1 uF. Q3 on the USB sheet is the DTR/RTS auto-program pair."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "8feae6c3-7871-40c3-bf87-3a2759de5c6a")
	)
	(text "R7 is the only chip-select pull-up. It is required because GPIO15 must be high at reset."
		(exclude_from_sim no)
		(at 16.0 224.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "0f551ed4-9953-4803-95a5-ec0548c29838")
	)
