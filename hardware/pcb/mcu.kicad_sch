	(text "GPIO2 and GPIO12 are open so the straps stay low. GPIO15 (CS_AD5940) is pulled up."
		(exclude_from_sim no)
		(at 16.0 200.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6ba31823-0053-419b-b30d-d53bde3e6351")
	)
	(text "GPIO6-11 are the module flash bus and have no symbol pins. ADC1 is GPIO36 and GPIO39."
		(exclude_from_sim no)
		(at 16.0 208.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "22dfbc42-fc4d-466d-9e29-ed695b11e9e0")
	)
	(text "EN and IO0 have pull-ups only. Download uses the module pads. There are no buttons."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "df347ce6-2942-4ed0-a3be-1a1908cd811b")
	)
	(text "R7 is the only chip-select pull-up. It is required because GPIO15 must be high at reset."
		(exclude_from_sim no)
		(at 16.0 224.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "760d0f00-2fc9-4f8a-b005-5758612931f0")
	)
