	(text "GPIO2 and GPIO12 are open so the straps stay low. GPIO15 (CS_AD5940) is pulled up."
		(exclude_from_sim no)
		(at 16.0 200.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "068b3890-8a72-4cde-81fa-7724cfb5c7ca")
	)
	(text "GPIO6-11 are the module flash bus and have no symbol pins. ADC sense is GPIO36 only."
		(exclude_from_sim no)
		(at 16.0 208.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "a46c28db-93e8-471c-8418-afd399dc3746")
	)
	(text "EN and IO0 have pull-ups only. Download uses the module pads. There are no buttons."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "c9bac8cd-73e2-4f8a-9fd6-ae132d3572d1")
	)
	(text "R7 is the only chip-select pull-up. It is required because GPIO15 must be high at reset."
