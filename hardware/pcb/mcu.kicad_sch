	(text "IO0 is the boot strap (SW2, R6). IO3 is JTAG-sel; R53 holds EXP_INT high. IO45/IO46 left unstrapped."
		(exclude_from_sim no)
		(at 16.0 200.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "d161139b-7f9b-4baf-8444-3b95a61618fa")
	)
	(text "IO26 is the in-module PSRAM select on N4R2. IO33-37, IO47, IO48 are spare GPIO, left open."
