	(text "GPIO2 and GPIO12 are open so the straps stay low. GPIO15 (CS_AD5940) is pulled up."
		(exclude_from_sim no)
		(at 16.0 200.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "7f904fe7-c32c-43dd-bd07-d27eb8f2ab29")
	)
	(text "GPIO6-11 are the module flash bus and have no symbol pins. ADC sense is GPIO36 only."
		(exclude_from_sim no)
		(at 16.0 208.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "07544ab3-bee6-4a3f-a695-e368e31199e7")
	)
	(text "TP1 and TP2 are pads so EN and IO0 can be strapped for download. There are no buttons."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "5974e035-d4a9-4ccd-8c80-342de7710721")
	)
	(text "R7 is the only chip-select pull-up. It is required because GPIO15 must be high at reset."
		(exclude_from_sim no)
		(at 16.0 224.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
