	(text "PWR_FLAG on VDD_CP2102 only. Do not tie this net to +3V3."
		(exclude_from_sim no)
		(at 40.0 175.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "d8e542c1-6164-4f7b-a72e-aebc6b59b56d")
	)
	(text "Unused inputs ~CTS, ~DSR, ~DCD and ~RI/CLK are tied to VDD_CP2102. R62 pulls ~RSTb up."
		(exclude_from_sim no)
		(at 40.0 181.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "733c5304-9d71-442c-b851-c50953ec1a94")
	)
	(text "R63/R64 are the Rev 1.5 Fig 2.5 divider. VREGIN is still the USB 5 V pin."
		(exclude_from_sim no)
		(at 40.0 187.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "8912a353-55fd-471e-be12-1114e6b4754e")
	)
	(text "C9+C62 on VDD, C1+C63 on VREGIN: 4.7 uF and 100 nF on each regulator pin."
		(exclude_from_sim no)
		(at 40.0 193.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "5164d8ce-b822-4d0e-bbc0-5a32913e7c59")
	)
	(text "R72 and R73 are 1k in series with TX and RX so an unpowered side is not back-driven."
		(exclude_from_sim no)
		(at 40.0 199.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "7eca4805-677e-4a3a-82c6-fc4210fe56fb")
	)
	(text "Q3 is the DevKitC auto-program pair: DTR/RTS to EN and GPIO0. R70 and R71 are the 10k bases."
		(exclude_from_sim no)
		(at 40.0 205.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "5473795d-ce10-4034-817e-5115660ae08a")
	)
