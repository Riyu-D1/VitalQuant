	(text "J2 is three flat pads (BAT+ BAT- NTC), not a header. No power switch."
		(exclude_from_sim no)
		(at 16.0 248.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "807c6ea9-5571-4690-b313-4775cb84db59")
	)
	(text "R61 is the on-board 10k NTC, DNP. Fit it or the cell NTC, not both. Q2 floats PROG until CHG_EN is high."
		(exclude_from_sim no)
		(at 16.0 256.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "6f69c3d9-1949-4376-8ffd-475056ac6e12")
	)
	(text "Charge stays off at power-up: the expander port is Hi-Z and R59 holds the gate low."
		(exclude_from_sim no)
		(at 16.0 264.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "f1986675-2ed7-4cc2-8dbf-0d6489896fc2")
	)
	(wire
		(pts
			(xy 392.43 129.54)
			(xy 392.43 142.24)
		)
		(stroke (width 0) (type default))
