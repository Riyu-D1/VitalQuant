	)
	(text "J2 is BAT+ (larger pad) BAT- NTC. The cell must have a 10k NTC and a protection PCM."
		(exclude_from_sim no)
		(at 16.0 248.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "31b8acf2-c288-46e1-be2c-807feae16665")
	)
	(text "R61 stays DNP. Fit the cell NTC, not R61 as well. R3 is 1.5k, so charge current is 200 mA."
		(exclude_from_sim no)
		(at 16.0 256.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "5730169d-7807-43d6-b36a-065fb6f9d73f")
	)
	(text "Charge is on whenever USB is present and TS is in range. CHG_DIS high shorts TS and stops it."
		(exclude_from_sim no)
		(at 16.0 264.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "bb154fa4-13a0-414c-8d7a-e90685d9d701")
	)
	(wire
		(pts
			(xy 392.43 129.54)
			(xy 392.43 142.24)
		)
		(stroke (width 0) (type default))
		(uuid "93765dfa-3fd6-4378-b042-18cf9bb28e17")
	)
	(wire
		(pts
			(xy 392.43 77.47)
			(xy 403.86 77.47)
		)
		(stroke (width 0) (type default))
		(uuid "af29e873-a858-4aca-82f1-5c6ff627646c")
	)
	(text "U3 is a TPS63802 buck-boost. R23/R24 set 3.30 V. C44 and C45 are the datasheet 0603 ceramics. C3 and C4 stay."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "6171fd87-89cd-4d16-b675-8ee39f208ad8")
	)
	(text "U4 is the 1.8 V LDO, fed from U3, EN tied to IN. AS7341 VDD is 1.7-2.0 V. Other ICs are 3.3 V."
		(exclude_from_sim no)
		(at 16.0 222.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "12eaee2e-edfd-4ed0-a6ad-c7c6b787bdb0")
	)
	(text "Load sits on VBAT. U17 is the MAX17048 (0x36). R49 pulls STAT up. R50/R51 divide VBUS to about 3.3 V."
		(exclude_from_sim no)
		(at 16.0 228.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "86f51122-dfd3-442a-9f37-f03f764b8bdc")
	)
	(text "Sheets below contain the parts. They are not empty stubs."
		(exclude_from_sim no)
		(at 16.0 204.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "61fbcc48-19f8-484a-925b-f1d17e4e9857")
	)
