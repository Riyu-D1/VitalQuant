	(text "TPS7A2018 (not 3.3 V): AS7341 VDD is 1.7-2.0 V. Every other IC runs at 3.3 V."
		(exclude_from_sim no)
		(at 16.0 186.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "2589cd0a-e5c5-4bf8-82f2-25596fba3b0f")
	)
	(text "U4 is fed from U3. EN is tied to IN. No separate 1.8 V XC6206."
		(exclude_from_sim no)
		(at 16.0 184.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "72b60035-5fa8-48f2-aded-f7834995e7c3")
	)
	(text "Load sits on VBAT. USB charges the cell and powers the UART. The board does not run from USB with the cell missing."
		(exclude_from_sim no)
		(at 16.0 190.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "f2782c15-b16d-4927-9a56-e6d602831420")
	)
	(text "R3 = 10k sets MCP73831 to 100 mA. STAT is open. No charge LED. H1 and H2 are M2 holes."
		(exclude_from_sim no)
		(at 16.0 196.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "d531712f-5cd9-48e6-96f3-e49f09ecb571")
	)
	(text "Sheets below contain the parts. They are not empty stubs."
