	(text "J2 is three flat pads (BAT+ BAT- NTC). The NTC goes to BQ25170 TS, not an ADC divider."
		(exclude_from_sim no)
		(at 16.0 248.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "da76e72d-c1bf-4d90-bfb9-0f35c2c122f6")
	)
	(text "R61 is the on-board 10k NTC, DNP. Fit it or the cell NTC, not both. Do not tie TS to +3V3."
		(exclude_from_sim no)
		(at 16.0 256.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "bd90f49a-9bd9-4d6c-96e0-4a5dbabe41a6")
	)
	(text "Charge is on whenever USB is present and TS is in range. CHG_DIS high shorts TS and stops it."
		(exclude_from_sim no)
		(at 16.0 264.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "758ce354-8738-41ba-985c-d3fea22357df")
