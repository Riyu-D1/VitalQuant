		(at 16.0 248.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "5730ecbb-6849-4f10-967a-4ccb04956aac")
	)
	(text "R61 stays DNP. Fit the cell NTC, not R61 as well. R3 is 1.5k, so charge current is 200 mA."
		(exclude_from_sim no)
		(at 16.0 256.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "c863ea38-5faf-4296-8b49-24bbcd1419df")
	)
	(text "Charge is on whenever USB is present and TS is in range. CHG_DIS high shorts TS and stops it."
		(exclude_from_sim no)
		(at 16.0 264.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "8ecd9cd2-a956-4561-b027-7dd9aa22e114")
	)
	(wire
		(pts
			(xy 392.43 129.54)
			(xy 392.43 142.24)
		)
		(stroke (width 0) (type default))
		(uuid "c81fd502-33e6-4b98-be22-07bdce5eea12")
