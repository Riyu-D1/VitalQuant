	)
	(wire
		(pts
			(xy 392.43 77.47)
			(xy 403.86 77.47)
		)
		(stroke (width 0) (type default))
		(uuid "e2e73132-b013-4f31-a2b0-470e44a33be3")
	)
	(text "U3 is a TPS63802 buck-boost. R23/R24 set 3.30 V. C44 and C45 are the datasheet 0603 ceramics. C3 and C4 stay."
		(exclude_from_sim no)
		(at 16.0 216.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "c034605d-ecac-4b86-9fd9-47713042beb1")
	)
	(text "U4 is the 1.8 V LDO, fed from U3, EN tied to IN. AS7341 VDD is 1.7-2.0 V. Other ICs are 3.3 V."
		(exclude_from_sim no)
		(at 16.0 222.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "c02ddcca-f3dc-4ae0-8ea5-8740a25c4239")
	)
	(text "Load sits on VBAT. U17 is the MAX17048 (0x36). R49 pulls STAT up. R50/R51 divide VBUS to about 3.3 V."
		(exclude_from_sim no)
		(at 16.0 228.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "44ce2386-06fe-4b0e-9a31-e5396685b9af")
	)
	(text "Sheets below contain the parts. They are not empty stubs."
		(exclude_from_sim no)
		(at 16.0 204.0 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "13d591ce-d893-49bd-902a-6f494aae6bf5")
	)
