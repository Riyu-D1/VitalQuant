	(text "J2 is BAT+ (larger pad) BAT- NTC. The cell must have a 10k NTC and a protection PCM."
		(exclude_from_sim no)
		(at 16.0 248.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "a5ea60f8-ddd5-4c37-85c2-a33e03383e33")
	)
	(text "R61 stays DNP. Fit the cell NTC, not R61 as well. R3 is 1.5k, so charge current is 200 mA."
		(exclude_from_sim no)
		(at 16.0 256.0 0)
		(effects (font (size 1.3 1.3)) (justify left bottom))
		(uuid "66d0bf52-405a-41f1-b394-0b8a05af8c27")
	)
	(text "Charge is on whenever USB is present and TS is in range. CHG_DIS high shorts TS and stops it."
		(exclude_from_sim no)
		(at 16.0 264.0 0)
		(effects (font (size 1.4 1.4)) (justify left bottom))
		(uuid "17840ba7-6447-4de6-8c0f-f7a11f1049ec")
	)
	(wire
		(pts
			(xy 392.43 129.54)
			(xy 392.43 142.24)
