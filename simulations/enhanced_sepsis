# STEP 3: BUILD SIMULATION WITH REAL DATA PARAMETERS
# -----------------------------------------------------------------------------

# Set random seed for reproducibility
np.random.seed(42)

# Time parameters (hours post-surgery)
time_hours = np.linspace(0, 24, 1000)

# Quantum squeezing parameter
CLASSICAL_SQUEEZING = 0.0
QUANTUM_SQUEEZING = 0.8

# Detection thresholds (clinical significance)
IL6_THRESHOLD = 40  # pg/mL
LACTATE_THRESHOLD = 2.5  # mmol/L
PH_THRESHOLD = 7.3
TEMP_THRESHOLD = 0.5  # °C above baseline

# Clinical symptom appearance
CLINICAL_SYMPTOM_TIME = 18.0  # hours

def build_biomarker_evolution(stats):
    """
    Build biomarker time evolution using real data statistics
    """
    
    # IL-6 evolution
    il6_baseline = stats.get('il6_baseline', 10)
    il6_peak = stats.get('il6_sepsis', 200)
    il6_onset = 12
    il6_rise_rate = 3
    
    il6 = il6_baseline + (il6_peak - il6_baseline) / (1 + np.exp(-(time_hours - il6_onset) / il6_rise_rate))
    
    # Lactate evolution
    lactate_baseline = stats.get('lactate_baseline', 1.0)
    lactate_peak = stats.get('lactate_sepsis', 5.0)
    lactate_onset = 14
    lactate_rise_rate = 2
    
    lactate = lactate_baseline + (lactate_peak - lactate_baseline) / (1 + np.exp(-(time_hours - lactate_onset) / lactate_rise_rate))
    
    # pH evolution
    ph_baseline = stats.get('ph_baseline', 7.40)
    ph_minimum = stats.get('ph_sepsis', 7.15)
    ph_onset = 15
    ph_drop_rate = 2.5
    
    ph = ph_baseline - (ph_baseline - ph_minimum) / (1 + np.exp(-(time_hours - ph_onset) / ph_drop_rate))
    
    # Temperature evolution
    temp_baseline = 0.0
    temp_peak = stats.get('temp_sepsis', 1.5) - stats.get('temp_baseline', 36.5)
    if temp_peak < 0:
        temp_peak = 1.5  # Fallback
    temp_onset = 13
    temp_rise_rate = 2
    
    temp = temp_baseline + temp_peak / (1 + np.exp(-(time_hours - temp_onset) / temp_rise_rate))
    
    return il6, lactate, ph, temp

# -----------------------------------------------------------------------------
# OPTICAL DETECTION MODELS
# -----------------------------------------------------------------------------

def raman_detection(concentration, squeezing_param, integration_time=1.0):
    """Raman spectroscopy detection with shot noise"""
    photon_count_rate = 100
    expected_photons = concentration * photon_count_rate * integration_time
    shot_noise_std = np.sqrt(expected_photons)
    quantum_noise_factor = np.exp(-squeezing_param)
    noise_std = shot_noise_std * quantum_noise_factor
    noise = np.random.normal(0, noise_std, size=len(concentration))
    measured_photons = expected_photons + noise
    measured_concentration = measured_photons / (photon_count_rate * integration_time)
    return measured_concentration

def nirs_detection(concentration, squeezing_param):
    """Near-infrared spectroscopy detection"""
    photon_count_rate = 500
    integration_time = 1.0
    expected_photons = concentration * photon_count_rate * integration_time
    shot_noise_std = np.sqrt(expected_photons)
    quantum_noise_factor = np.exp(-squeezing_param)
    noise_std = shot_noise_std * quantum_noise_factor
    noise = np.random.normal(0, noise_std, size=len(concentration))
    measured_photons = expected_photons + noise
    measured_concentration = measured_photons / (photon_count_rate * integration_time)
    return measured_concentration

def thermal_detection(temperature, squeezing_param):
    """Thermal infrared detection"""
    classical_noise_std = 0.1
    quantum_noise_factor = np.exp(-squeezing_param)
    noise_std = classical_noise_std * quantum_noise_factor
    noise = np.random.normal(0, noise_std, size=len(temperature))
    measured_temp = temperature + noise
    return measured_temp

def find_detection_time(measured_values, threshold, time_hours):
    """Find first time point where measured value exceeds threshold"""
    window = 20
    smoothed = np.convolve(measured_values, np.ones(window)/window, mode='same')
    crossings = np.where(smoothed > threshold)[0]
    if len(crossings) > 0:
        return time_hours[crossings[0]]
    return None

