def extract_biomarker_stats(df):
    """
    Extract realistic biomarker statistics from the dataset.
    
    Returns dictionary with:
    - baseline values (normal patients)
    - sepsis values (septic patients)
    - standard deviations
    """
    
    if df is None:
        # Use theoretical values if no data
        return {
            'il6_baseline': 10,
            'il6_sepsis': 200,
            'il6_std': 50,
            'lactate_baseline': 1.0,
            'lactate_sepsis': 5.0,
            'lactate_std': 1.5,
            'has_real_data': False
        }
    
    stats = {'has_real_data': True}
    
    # Look for sepsis indicator column
    # Common names: 'sepsis', 'SepsisLabel', 'outcome', 'target'
    sepsis_col = None
    for col in ['sepsis', 'SepsisLabel', 'outcome', 'target', 'Sepsis']:
        if col in df.columns:
            sepsis_col = col
            break
    
    if sepsis_col is None:
        print("⚠ Could not find sepsis label column")
        stats['has_real_data'] = False
        return stats
    
    # Split into normal and sepsis patients
    normal_patients = df[df[sepsis_col] == 0]
    sepsis_patients = df[df[sepsis_col] == 1]
    
    print(f"\n✓ Found {len(normal_patients)} normal and {len(sepsis_patients)} sepsis records")
    
    # Extract IL-6 if available (might be named differently)
    il6_cols = [c for c in df.columns if 'il6' in c.lower() or 'interleukin' in c.lower()]
    if il6_cols:
        il6_col = il6_cols[0]
        stats['il6_baseline'] = normal_patients[il6_col].mean()
        stats['il6_sepsis'] = sepsis_patients[il6_col].mean()
        stats['il6_std'] = sepsis_patients[il6_col].std()
        print(f"✓ IL-6: baseline={stats['il6_baseline']:.1f}, sepsis={stats['il6_sepsis']:.1f}")
    
    # Extract lactate
    lactate_cols = [c for c in df.columns if 'lactate' in c.lower() or 'lac' in c.lower()]
    if lactate_cols:
        lac_col = lactate_cols[0]
        stats['lactate_baseline'] = normal_patients[lac_col].mean()
        stats['lactate_sepsis'] = sepsis_patients[lac_col].mean()
        stats['lactate_std'] = sepsis_patients[lac_col].std()
        print(f"✓ Lactate: baseline={stats['lactate_baseline']:.2f}, sepsis={stats['lactate_sepsis']:.2f}")
    
    # Extract pH if available
    ph_cols = [c for c in df.columns if 'ph' in c.lower()]
    if ph_cols:
        ph_col = ph_cols[0]
        stats['ph_baseline'] = normal_patients[ph_col].mean()
        stats['ph_sepsis'] = sepsis_patients[ph_col].mean()
        print(f"✓ pH: baseline={stats['ph_baseline']:.2f}, sepsis={stats['ph_sepsis']:.2f}")
    
    # Extract temperature
    temp_cols = [c for c in df.columns if 'temp' in c.lower() or 'temperature' in c.lower()]
    if temp_cols:
        temp_col = temp_cols[0]
        stats['temp_baseline'] = normal_patients[temp_col].mean()
        stats['temp_sepsis'] = sepsis_patients[temp_col].mean()
        print(f"✓ Temp: baseline={stats['temp_baseline']:.2f}, sepsis={stats['temp_sepsis']:.2f}")
    
    return stats

